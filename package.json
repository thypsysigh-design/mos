{
  "name": "mos-adventure",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/game.test.ts src/localization/localization.test.ts && npm run texts:test",
    "export": "expo export --platform all",
    "playtest": "expo export --platform web --output-dir web-dist --max-workers 2 && node scripts/build-playtest.mjs",
    "texts:import": "node scripts/import-items.mjs && node scripts/import-texts.mjs && npm run monsters:import",
    "texts:check": "node scripts/import-items.mjs --check && node scripts/import-texts.mjs --check && npm run monsters:check",
    "texts:test": "node --test scripts/text-catalog.test.mjs scripts/item-catalog.test.mjs scripts/monster-catalog.test.mjs",
    "prestart": "npm run texts:import",
    "preweb": "npm run texts:import",
    "preandroid": "npm run texts:import",
    "preios": "npm run texts:import",
    "preexport": "npm run texts:import",
    "preplaytest": "npm run texts:import",
    "pretest": "npm run texts:check",
    "items:import": "node scripts/import-items.mjs",
    "items:check": "node scripts/import-items.mjs --check",
    "monsters:import": "node scripts/import-monsters.mjs",
    "monsters:check": "node scripts/import-monsters.mjs --check"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.28",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
