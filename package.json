{
  "name": "mos-adventure",
  "version": "0.5.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/game.test.ts",
    "export": "expo export --platform all",
    "playtest": "expo export --platform web --output-dir web-dist --max-workers 2 && node scripts/build-playtest.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.28",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "tsx": "^4.20.0",
    "@types/react": "^19.2.0"
  }
}
